# Public application URL used for auth callback links.
# Set this to your production URL in Vercel; localhost works for local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and browser key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use the publishable key from Supabase Dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key
# For older projects, use this instead of the publishable key above:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-project-anon-key

# Server-only Supabase key. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-server-only-secret-key
# For projects still using the legacy service-role key, use this instead:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Generate a separate random value for each secret below with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# SUPABASE_LRN_HMAC_SECRET must be at least 32 UTF-8 bytes.
SUPABASE_LRN_HMAC_SECRET=replace-with-a-new-random-secret
# SUPABASE_DATA_ENCRYPTION_KEY encrypts student birthdays and must be base64 for 32 random bytes.
# Generate it separately from the HMAC secret and keep it stable for existing data.
SUPABASE_DATA_ENCRYPTION_KEY=replace-with-a-separate-32-byte-base64-key
# Contact-form PII uses its own 32-byte key to separate it from student birthday encryption.
# Generate it independently and keep it stable while encrypted contact rows exist.
SUPABASE_CONTACT_ENCRYPTION_KEY=replace-with-another-independent-32-byte-base64-key

# Public SEO and privacy settings. The verification value comes from Google Search Console.
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Server-only comma-separated email allowlist for the encrypted contact inbox API.
# Set this to the verified accounts authorized by the school to read contact messages.
SUPABASE_CONTACT_ADMIN_EMAILS=
