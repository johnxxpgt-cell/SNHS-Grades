NEXT_PUBLIC_APP_URL=https://snhs-grades.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Legacy server-side service-role keys can use SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=server-only-supabase-secret-key
SUPABASE_LRN_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SUPABASE_DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
